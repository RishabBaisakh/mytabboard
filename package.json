{
  "name": "mytabboard",
  "displayName": "Mytabboard",
  "version": "0.0.1",
  "description": "Your AI-powered new tab workspace for tasks, planning, insights, and daily productivity.",
  "author": "Rishab Baisakh",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.57.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "permissions": [
      "identity",
      "storage"
    ],
    "host_permissions": [
      "http://localhost:8000/*",
      "http://127.0.0.1:8000/*"
    ],
    "oauth2": {
      "client_id": "$PLASMO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID",
      "scopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  }
}
